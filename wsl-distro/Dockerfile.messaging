FROM hermes-core:latest

ENV DEBIAN_FRONTEND=noninteractive

# Install all messaging platform dependencies
RUN uv pip install --python /opt/hermes/venv/bin/python \
    "python-telegram-bot[webhooks]==22.6" \
    "discord.py[voice]==2.7.1" \
    "aiohttp==3.13.3" \
    "brotlicffi==1.2.0.1" \
    "slack-bolt==1.27.0" \
    "slack-sdk==3.40.1" \
    "qrcode==7.4.2" \
    "dingtalk-stream==0.24.3" \
    "alibabacloud-dingtalk==2.2.42" \
    "lark-oapi==1.5.3"

# Install cloud provider SDKs
RUN uv pip install --python /opt/hermes/venv/bin/python \
    "anthropic==0.86.0" \
    "boto3==1.42.89" \
    "azure-identity==1.25.3"

# Install web search backends
RUN uv pip install --python /opt/hermes/venv/bin/python \
    "exa-py==2.10.2" \
    "firecrawl-py==4.17.0" \
    "parallel-web==0.4.2" \
    "fal-client==0.13.1"

WORKDIR /opt/hermes
