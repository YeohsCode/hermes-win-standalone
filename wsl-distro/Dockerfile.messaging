FROM hermes-core:latest

ENV DEBIAN_FRONTEND=noninteractive

# Install messaging-platform extras via the agent's own extras (single source
# of truth for versions/transitives — see hermes-agent pyproject.toml):
#   [messaging]      -> python-telegram-bot + discord.py + aiohttp + brotlicffi
#                       + slack-bolt + slack-sdk + qrcode
#   [dingtalk]       -> dingtalk-stream + alibabacloud-dingtalk + qrcode
#   [feishu]         -> lark-oapi + qrcode
#   [wecom]          -> defusedxml (WeCom callback adapter)
#   [bedrock]        -> boto3 (AWS Bedrock provider)
#   [azure-identity] -> azure-identity (Azure provider auth)
# Note: anthropic and the web-search backends (exa/firecrawl/parallel-web/fal)
# moved into the core layer, so they are no longer installed here.
WORKDIR /opt/hermes/hermes-agent
RUN uv pip install --python /opt/hermes/venv/bin/python \
    -e ".[messaging,dingtalk,feishu,wecom,bedrock,azure-identity]"

# Strip caches and bytecode introduced by this layer
RUN find /opt/hermes/venv -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/hermes/venv -type f -name '*.pyc' -delete 2>/dev/null || true && \
    rm -rf /root/.cache/pip /root/.cache/uv /tmp/* /var/tmp/*

WORKDIR /opt/hermes
