FROM hermes-core:latest

ENV DEBIAN_FRONTEND=noninteractive

# Install ffmpeg for audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Install voice extras via the agent's own extras (single source of truth for
# versions/transitives — see hermes-agent pyproject.toml):
#   [voice]       -> faster-whisper + ctranslate2 + onnxruntime + sounddevice + numpy (~400MB)
#   [tts-premium] -> elevenlabs
# edge-tts already lives in core, so it's not repeated here.
WORKDIR /opt/hermes/hermes-agent
RUN uv pip install --python /opt/hermes/venv/bin/python -e ".[voice,tts-premium]"

# Strip caches and bytecode introduced by this layer
RUN find /opt/hermes/venv -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/hermes/venv -type f -name '*.pyc' -delete 2>/dev/null || true && \
    rm -rf /root/.cache/pip /root/.cache/uv /tmp/* /var/tmp/*

WORKDIR /opt/hermes
